# Folder with your original photos (JPEG, PNG, TIFF or WebP).
# An optional captions.json next to them adds titles and captions, see README.
PHOTOS_SRC=/Users/you/Pictures/kl-w

# Cloudflare R2. The account ID is on the R2 overview page.
# Create an account API token with "Object Read & Write" scoped to the bucket.
R2_ACCOUNT_ID=
R2_BUCKET=kl-w-photos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
